# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of proxy hops to trust for client IPs (1 when behind Nginx)
TRUST_PROXY=0
# Public URL of the web app (used in certificate verification links, emails)
APP_PUBLIC_URL=http://localhost:5173
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Swagger UI at /api/docs is always on outside production; set true to expose it in production
API_DOCS_ENABLED=false

# ── Database / cache ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://trustai:trustai_dev_password@localhost:5433/trustai?schema=public
# Optional. When set, rate limits are shared across API instances.
REDIS_URL=

# ── Authentication ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_ISSUER=trustworthy-ai-platform
JWT_AUDIENCE=trustworthy-ai-platform-web
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=tai_rt
# true in production (HTTPS only cookies)
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# ── ML service ───────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
# Shared secret for service-to-service calls (min 32 chars)
ML_SERVICE_TOKEN=change-me-internal-service-token-min-32-chars

# ── File storage ─────────────────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=../storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=trustai
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Seeding (development only) ───────────────────────────────────────────
SEED_DEFAULT_PASSWORD=TrustAI!2026
